        "#\n",
        "#  INPUT:  Malware grayscale image (any size)\n",
        "#  OUTPUT: Malware family prediction + confidence\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CELL 1 — Imports & Drive Mount\n",
        "# ============================================================\n",
        "import os\n",
        "import time\n",
        "import numpy as np\n",
