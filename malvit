        "\n",
        "\n",
        "# ============================================================\n",
        "# CELL 2 — Load TFLite Interpreter\n",
        "# ============================================================\n",
        "\n",
        "interpreter = tf.lite.Interpreter(model_path=TFLITE_PATH)\n",
        "interpreter.allocate_tensors()\n",
        "\n",
        "input_details  = interpreter.get_input_details()[0]\n",
