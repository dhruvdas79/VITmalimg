        "\n",
        "    if show_plot:\n",
        "        _plot_result(original, img_resized, patches, probs, top5, pred_class,\n",
        "                     confidence, avg_lat, image_path)\n",
        "\n",
        "    return pred_idx, probs, avg_lat\n",
        "\n",
        "\n",
        "def _plot_result(original, img_resized, patches, probs, top5,\n",
        "                 pred_class, confidence, latency, image_path):\n",
