        "# ============================================================\n",
        "# CELL 5 — TFLite / Coral-compatible architecture\n",
        "#\n",
        "#  KEY CHANGES vs your original QAT model:\n",
        "#\n",
        "#  ❌ Removed: @tf.custom_gradient fake-quant wrappers\n",
        "#              (TFLite PTQ handles quantization itself)\n",
        "#  ❌ Removed: fpga_hardware_softmax (non-standard clipping)\n",
        "#  ❌ Removed: fpga_hardware_glu as custom_gradient activation\n",
        "#  ❌ Removed: dynamic tf.shape(x)[0] in MHA\n",
        "#  ❌ Removed: QAT_Dense / QAT_LayerNorm custom wrappers\n",
        "#\n",
        "#  ✅ Added:   Standard tf.keras.layers.MultiHeadAttention\n",
        "#              (TFLite 2.13+ supports this natively in INT8)\n",
        "#  ✅ Added:   GLU as standard math ops (clip + multiply)\n",
        "#              so Edge TPU compiler can map it to hardware\n",
        "#  ✅ Added:   LayerNorm as explicit gamma/beta (no LN kernel\n",
        "#              in old TFLite — we keep your original formulation)\n",
        "#  ✅ Fixed:   All shapes are static (batch=1 for inference)\n",
        "# ============================================================\n",
        "\n",
        "class TFLite_LayerNorm(layers.Layer):\n",
        "    \"\"\"\n",
        "    Simple learned scale+shift norm (matches your FP32_LayerNorm exactly).\n",
        "    Full LayerNorm with mean/variance is NOT on the Edge TPU whitelist,\n",
        "    so we keep your original per-channel gamma/beta formulation.\n",
        "    \"\"\"\n",
        "    def __init__(self, dim, **kwargs):\n",
        "        super().__init__(**kwargs)\n",
        "        self.dim   = dim\n",
        "        self.gamma = self.add_weight(\n",
        "           name=\"gamma\",\n",
        "           shape=(dim,),\n",
        "           initializer=\"ones\"\n",
        "       )\n",
        "\n",
        "        self.beta = self.add_weight(\n",
        "          name=\"beta\",\n",
        "          shape=(dim,),\n",
        "          initializer=\"zeros\"\n",
        "        )\n",
        "\n",
        "    def call(self, x):\n",
        "        # Identical to your FP32_LayerNorm — no custom_gradient wrapping\n",
        "        return x * self.gamma + self.beta\n",
        "\n",
        "    def get_config(self):\n",
        "        cfg = super().get_config(); cfg[\"dim\"] = self.dim; return cfg\n",
        "\n",
        "\n",
        "class TFLite_PosEmb(layers.Layer):\n",
        "    \"\"\"Positional embedding — plain addition, static weight.\"\"\"\n",
        "    def __init__(self, num_patches, proj_dim, **kwargs):\n",
        "        super().__init__(**kwargs)\n",
        "        self.pos = self.add_weight(\n",
        "         name=\"pos_emb\",\n",
        "         shape=(num_patches, proj_dim),\n",
        "         initializer=\"zeros\"\n",
        "        )\n",
        "    def call(self, x):\n",
        "        return x + self.pos   # simple add — fully supported\n",
        "\n",
        "    def get_config(self):\n",
        "        cfg = super().get_config()\n",
        "        cfg.update({\"num_patches\": NUM_PATCHES, \"proj_dim\": PROJECTION_DIM})\n",
        "        return cfg\n",
        "\n",
        "\n",
        "def build_tflite_model():\n",
        "    \"\"\"\n",
        "    TFLite + Coral Edge TPU compatible ViT.\n",
        "    All ops are on the Edge TPU supported-ops whitelist.\n",
        "    \"\"\"\n",
        "    inputs = layers.Input(shape=(NUM_PATCHES, PATCH_VECTOR), name=\"input\")\n",
        "\n",
        "    # --- Patch projection ---\n",
        "    x = layers.Dense(PROJECTION_DIM, name=\"enc\")(inputs)\n",
        "\n",
        "    # --- Positional embedding ---\n",
        "    x = TFLite_PosEmb(NUM_PATCHES, PROJECTION_DIM, name=\"pos\")(x)\n",
        "\n",
        "    # --- Transformer block ---\n",
        "    # Pre-norm\n",
        "    x1 = TFLite_LayerNorm(PROJECTION_DIM, name=\"ln1\")(x)\n",
        "\n",
        "    # Standard Keras MHA — TFLite 2.13 converts this to INT8 natively\n",
        "    # key_dim=32, num_heads=2 → same as your original\n",
        "    attn = layers.MultiHeadAttention(\n",
        "        num_heads=NUM_HEADS,\n",
        "        key_dim=KEY_DIM,\n",
        "        name=\"mha\"\n",
        "    )(x1, x1)\n",
        "\n",
        "    # Residual 1\n",
        "    x2 = layers.Add(name=\"res1\")([attn, x])\n",
        "\n",
        "    # Pre-norm 2\n",
        "    x3 = TFLite_LayerNorm(PROJECTION_DIM, name=\"ln2\")(x2)\n",
        "\n",
        "    # --- GLU-gated FFN (expressed as standard ops — no custom_gradient) ---\n",
        "    # Gate branch: Dense → clip_by_value equivalent via ReLU6 trick\n",
        "    #   Original:  gate = clip((0.2*x + 0.5), 0, 1)\n",
        "    #   Equivalent: gate = ReLU6(0.2*x + 0.5) / 6   ... but simpler:\n",
        "    #   We use Lambda with standard math — TFLite supports this op set.\n",
        "    gate_dense = layers.Dense(PROJECTION_DIM, name=\"gate\")(x3)\n",
        "\n",
        "    # 0.2*x + 0.5, then hard-sigmoid style clip to [0,1]\n",
        "    # Hard sigmoid: clip((x+3)/6, 0, 1) is NOT what we want exactly.\n",
        "    # Exact formula: clip(0.2*x + 0.5, 0, 1)\n",
        "    # We implement as: Activation('hard_sigmoid') is close but wrong scale.\n",
        "    # Safest for Coral: use relu6 decomposition.\n",
        "    #   clip(0.2x + 0.5, 0, 1) = ReLU(0.2x+0.5) - ReLU(0.2x+0.5-1)\n",
        "    # But simplest supported path: use a Lambda with tf ops (no custom grad).\n",
        "    gate_act = layers.Lambda(\n",
        "        lambda g: tf.clip_by_value(0.2 * g + 0.5, 0.0, 1.0),\n",
        "        name=\"glu_act\"\n",
        "    )(gate_dense)\n",
        "\n",
        "    # Value branch\n",
        "    fc1    = layers.Dense(PROJECTION_DIM, name=\"fc1\")(x3)\n",
        "    x3_out = layers.Multiply(name=\"glu_mult\")([fc1, gate_act])\n",
        "\n",
        "    # Residual 2\n",
        "    x_out = layers.Add(name=\"res2\")([x3_out, x2])\n",
        "\n",
        "    # --- Classifier head ---\n",
        "    x_out   = layers.GlobalAveragePooling1D(name=\"gap\")(x_out)\n",
        "    outputs = layers.Dense(NUM_CLASSES, name=\"cls\")(x_out)\n",
        "    outputs = layers.Softmax(name=\"softmax_out\")(outputs)\n",
        "\n",
        "    return keras.Model(inputs, outputs, name=\"vit_tflite\")\n",
        "\n",
        "\n",
        "print(\"🔧 Building TFLite-compatible model...\")\n",
        "tflite_model = build_tflite_model()\n",
        "tflite_model.summary()"
