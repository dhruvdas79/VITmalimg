        "# NOTE on PATCH_VECTOR=192:\n",
        "# Your model was trained with patch_vector=192, meaning each 16x16 patch\n",
        "# was flattened differently OR had a specific preprocessing.\n",
        "# We replicate the EXACT same preprocessing here.\n",
        "# If predictions look wrong, see CELL 6 for diagnostics.\n",
        "\n",
        "# Malimg 25-class names\n",
        "CLASS_NAMES = [\n",
        "    \"Adialer.C\",     \"Agent.FYI\",      \"Allaple.A\",       \"Allaple.L\",\n",
        "    \"Alueron.gen!J\", \"Autorun.K\",      \"C2LOP.P\",         \"C2LOP.gen!g\",\n",
        "    \"Dialplatform.B\",\"Dontovo.A\",      \"Fakerean\",        \"Instantaccess\",\n",
