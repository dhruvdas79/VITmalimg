        "    print(f\"  │  Latency:    {avg_lat:6.2f} ms  ({RUNS} run avg)          │\")\n",
        "    print(f\"  └─────────────────────────────────────────────┘\")\n",
        "\n",
        "    print(f\"\\n  Top-5 Predictions:\")\n",
        "    for rank, idx in enumerate(top5):\n",
        "        bar_len = int(probs[idx] * 35)\n",
