        "# ============================================================\n",
        "# CELL 6 — Weight Transfer: FP32 → TFLite model\n",
        "#\n",
        "#  We copy every weight tensor by name/position.\n",
        "#  Your .h5 weights are perfectly reusable — only the\n",
        "#  wrapping layers change, not the numerical values.\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n⚙️  Transferring weights from FP32 model...\")\n",
        "\n",
        "# fp32_weighted index reference (from Cell 4 printout):\n",
        "# [0] Dense (enc)\n",
        "# [1] FP32_AddPosEmb (pos)\n",
        "# [2] FP32_LayerNorm (ln1)\n",
        "# [3] MultiHeadAttention (mha)\n",
        "# [4] FP32_LayerNorm (ln2)\n",
        "# [5] Dense (gate)\n",
        "# [6] Dense (fc1)\n",
        "# [7] Dense (cls)\n",
        "\n",
        "# [0] Encoder projection\n",
        "tflite_model.get_layer(\"enc\").set_weights(fp32_weighted[0].get_weights())\n",
        "print(\"  ✅ enc (patch projection)\")\n",
        "\n",
        "# [1] Positional embedding\n",
        "tflite_model.get_layer(\"pos\").set_weights(fp32_weighted[1].get_weights())\n",
        "print(\"  ✅ pos (positional embedding)\")\n",
        "\n",
        "# [2] LayerNorm 1\n",
        "tflite_model.get_layer(\"ln1\").set_weights(fp32_weighted[2].get_weights())\n",
        "print(\"  ✅ ln1 (layer norm 1)\")\n",
