        "\n",
        "print(\"✅ TFLite interpreter loaded.\")\n",
        "print(f\"   Input  shape : {input_details['shape']}  dtype: {input_details['dtype'].__name__}\")\n",
        "print(f\"   Output shape : {output_details['shape']} dtype: {output_details['dtype'].__name__}\")\n",
        "print(f\"   in_scale={in_scale:.6f}  in_zp={in_zp}\")\n",
        "print(f\"   out_scale={out_scale:.6f}  out_zp={out_zp}\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CELL 3 — Image Preprocessing Pipeline\n",
        "#\n",
        "#  Malimg dataset uses grayscale binary visualizations.\n",
        "#  The preprocessing MUST match what was used during training.\n",
        "#\n",
        "#  Standard Malimg preprocessing:\n",
        "#  1. Load as grayscale\n",
        "#  2. Resize to fixed size (256x256)\n",
        "#  3. Normalize pixels to [0, 1] or [-1, 1]\n",
        "#  4. Divide into 16x16 patches → 256 patches\n",
        "#  5. Each patch flattened → but PATCH_VECTOR=192, not 256\n",
        "#     This means training used a specific patch extraction method.\n",
        "#     We try both and let you verify.\n",
        "# ============================================================\n",
        "\n",
        "def load_and_preprocess_image(image_path, target_size=IMAGE_SIZE):\n",
        "    \"\"\"\n",
        "    Load malware visualization image and preprocess for ViT.\n",
        "    Returns: (preprocessed_patches, original_image_array)\n",
        "    \"\"\"\n",
        "    img = Image.open(image_path).convert('L')  # grayscale\n",
        "    original = np.array(img)\n",
        "\n",
        "    # Resize to IMAGE_SIZE x IMAGE_SIZE\n",
        "    img_resized = img.resize((target_size, target_size), Image.LANCZOS)\n",
        "    img_arr = np.array(img_resized, dtype=np.float32)\n",
        "\n",
        "    # Normalize to [0, 1]\n",
        "    img_arr = img_arr / 255.0\n",
        "\n",
        "    return img_arr, original\n",
        "\n",
        "\n",
        "def image_to_patches_v1(img_arr, patch_size=PATCH_SIZE):\n",
        "    \"\"\"\n",
        "    Method 1: Standard ViT patching\n",
        "    256x256 image → 16x16 grid → 256 patches of size 16x16\n",
        "    Each patch flattened to 256 dims, then first 192 taken.\n",
        "    (If your training used this, use v1)\n",
        "    \"\"\"\n",
        "    H, W = img_arr.shape\n",
        "    patches = []\n",
        "    for i in range(0, H, patch_size):\n",
        "        for j in range(0, W, patch_size):\n",
        "            patch = img_arr[i:i+patch_size, j:j+patch_size].flatten()\n",
        "            # If patch is 256 but model expects 192, take first 192\n",
        "            if len(patch) > PATCH_VECTOR:\n",
        "                patch = patch[:PATCH_VECTOR]\n",
        "            elif len(patch) < PATCH_VECTOR:\n",
        "                patch = np.pad(patch, (0, PATCH_VECTOR - len(patch)))\n",
        "            patches.append(patch)\n",
        "    patches = np.array(patches, dtype=np.float32)\n",
        "    return patches  # shape: (256, 192)\n",
        "\n",
        "\n",
        "def image_to_patches_v2(img_arr, patch_size=PATCH_SIZE):\n",
        "    \"\"\"\n",
        "    Method 2: Patch with stride — overlapping patches\n",
        "    Sometimes used to get 256 patches of exactly 192 dims.\n",
        "    (If your training used this, use v2)\n",
        "\n",
        "    12x16 = 192 pixel patch via non-square patching.\n",
        "    \"\"\"\n",
        "    H, W = img_arr.shape\n",
        "    patches = []\n",
        "    # Use 12x16 patches to get exactly 192-dim vectors\n",
        "    ph, pw = 12, 16\n",
        "    step_h = (H - ph) // 15  # 16 rows of patches\n",
        "    step_w = (W - pw) // 15  # 16 cols of patches\n",
        "\n",
        "    for i in range(16):\n",
        "        for j in range(16):\n",
        "            r = i * step_h\n",
        "            c = j * step_w\n",
        "            patch = img_arr[r:r+ph, c:c+pw].flatten()  # 12*16=192\n",
        "            patches.append(patch)\n",
        "\n",
        "    patches = np.array(patches, dtype=np.float32)\n",
        "    return patches  # shape: (256, 192)\n",
        "\n",
        "\n",
        "def image_to_patches_v3(img_arr):\n",
        "    \"\"\"\n",
        "    Method 3: Row-based patching\n",
        "    Each row of 192 pixels becomes one patch vector.\n",
        "    256 rows × 192 cols → resize image to 256×192 first.\n",
        "    \"\"\"\n",
        "    img_resized = np.array(\n",
        "        Image.fromarray((img_arr * 255).astype(np.uint8)).resize((192, 256), Image.LANCZOS),\n",
        "        dtype=np.float32\n",
        "    ) / 255.0\n",
        "    # Each row is one patch\n",
        "    patches = img_resized  # shape: (256, 192) directly\n",
        "    return patches\n",
        "\n",
        "\n",
        "def preprocess_for_model(image_path, method='v3'):\n",
        "    \"\"\"\n",
        "    Full pipeline: image path → model-ready patches\n",
        "    method: 'v1', 'v2', or 'v3' — try v3 first (most common for 256x192 input)\n",
        "    \"\"\"\n",
        "    img_arr, original = load_and_preprocess_image(image_path)\n",
        "\n",
        "    if method == 'v1':\n",
        "        patches = image_to_patches_v1(img_arr)\n",
        "    elif method == 'v2':\n",
        "        patches = image_to_patches_v2(img_arr)\n",
        "    else:  # v3 — default\n",
        "        patches = image_to_patches_v3(img_arr)\n",
        "\n",
        "    return patches, original, img_arr\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CELL 4 — INT8 Inference Function\n",
        "# ============================================================\n",
        "\n",
        "def predict_int8(patches):\n",
        "    \"\"\"\n",
        "    patches: np.array of shape (256, 192) float32\n",
        "    Returns: (predicted_class_idx, probabilities, latency_ms)\n",
        "    \"\"\"\n",
        "    # Quantize to INT8\n",
        "    x = np.round(patches / in_scale + in_zp).clip(-128, 127).astype(np.int8)\n",
        "    x = x[np.newaxis, ...]  # add batch dim → (1, 256, 192)\n",
        "\n",
        "    interpreter.resize_tensor_input(input_details['index'], x.shape)\n",
        "    interpreter.allocate_tensors()\n",
        "\n",
        "    t0 = time.perf_counter()\n",
        "    interpreter.set_tensor(input_details['index'], x)\n",
        "    interpreter.invoke()\n",
        "    latency = (time.perf_counter() - t0) * 1000\n",
        "\n",
        "    # Dequantize output\n",
        "    y_int8  = interpreter.get_tensor(output_details['index'])\n",
        "    y_float = (y_int8.astype(np.float32) - out_zp) * out_scale\n",
        "\n",
        "    probs = y_float[0]\n",
        "    # Softmax if not already applied\n",
        "    probs = y_float[0]\n",
        "\n",
        "    pred_idx = np.argmax(probs)\n",
        "    return pred_idx, probs, latency\n",
        "\n",
        "\n",
        "def classify_image(image_path, method='v3', show_plot=True):\n",
        "    \"\"\"\n",
        "    Full classify pipeline with visualization.\n",
        "    \"\"\"\n",
        "    print(f\"\\n{'='*55}\")\n",
