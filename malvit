        "# ============================================================\n",
        "# CELL 3 — Architecture constants (must match your trained model)\n",
        "# ============================================================\n",
        "NUM_PATCHES    = 256\n",
        "PATCH_VECTOR   = 192\n",
        "PROJECTION_DIM = 64\n",
        "NUM_HEADS      = 2\n",
        "KEY_DIM        = 32      # per-head dim; total proj = NUM_HEADS * KEY_DIM = 64\n",
        "NUM_CLASSES    = 25\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CELL 4 — Original FP32 skeleton\n",
        "#\n",
        "#  This is the EXACT same architecture used when the .h5 was\n",
        "#  trained. We need it only to load weights — it is NOT the\n",
        "#  model we will convert to TFLite.\n",
        "#\n",
        "#  Custom layers from your original code are registered here\n",
        "#  so that keras.models.load_model() can deserialize the file.\n",
        "# ============================================================\n",
        "\n",
        "# --- Minimal stubs so Keras can deserialize the .h5 ---\n",
        "# (We only need get_weights() from these; forward-pass does not matter here.)\n",
        "\n",
        "class FP32_LayerNorm(layers.Layer):\n",
        "    def __init__(self, dim, **kwargs):\n",
        "        super().__init__(**kwargs)\n",
        "        self.dim = dim\n",
        "        self.gamma = self.add_weight(\n",
        "           name=\"gamma\",\n",
        "           shape=(dim,),\n",
        "           initializer=\"ones\"\n",
        "       )\n",
        "\n",
        "        self.beta = self.add_weight(\n",
        "          name=\"beta\",\n",
        "          shape=(dim,),\n",
        "          initializer=\"zeros\"\n",
        "        )\n",
        "    def call(self, x):\n",
        "        return x * self.gamma + self.beta\n",
        "    def get_config(self):\n",
        "        cfg = super().get_config(); cfg[\"dim\"] = self.dim; return cfg\n",
        "\n",
        "class FP32_AddPosEmb(layers.Layer):\n",
        "    def __init__(self, num_patches, proj_dim, **kwargs):\n",
        "        super().__init__(**kwargs)\n",
        "        self.pos = self.add_weight(\n",
        "    name=\"pos_emb\",\n",
        "    shape=(num_patches, proj_dim),\n",
        "    initializer=\"zeros\"\n",
        "    )\n",
        "    def call(self, x):\n",
        "        return x + self.pos\n",
        "    def get_config(self):\n",
        "        cfg = super().get_config()\n",
        "        cfg.update({\"num_patches\": NUM_PATCHES, \"proj_dim\": PROJECTION_DIM})\n",
        "        return cfg\n",
        "\n",
        "class HW_GLU_Activation(layers.Layer):\n",
        "    def call(self, gate):\n",
        "        return tf.clip_by_value((0.2 * gate) + 0.5, 0.0, 1.0)\n",
        "\n",
        "def build_fp32_skeleton():\n",
        "    \"\"\"Exact replica of the architecture saved in the .h5 file.\"\"\"\n",
        "    inputs = layers.Input(shape=(NUM_PATCHES, PATCH_VECTOR))\n",
        "    x      = layers.Dense(PROJECTION_DIM)(inputs)\n",
        "    x      = FP32_AddPosEmb(NUM_PATCHES, PROJECTION_DIM)(x)\n",
        "    x1     = FP32_LayerNorm(PROJECTION_DIM)(x)\n",
        "    attn   = layers.MultiHeadAttention(num_heads=NUM_HEADS, key_dim=KEY_DIM)(x1, x1)\n",
        "    x2     = layers.Add()([attn, x])\n",
        "    x3     = FP32_LayerNorm(PROJECTION_DIM)(x2)\n",
        "    gate   = layers.Dense(PROJECTION_DIM)(x3)\n",
        "    gate   = HW_GLU_Activation()(gate)\n",
        "    fc1    = layers.Dense(PROJECTION_DIM)(x3)\n",
        "    x3_out = layers.Multiply()([fc1, gate])\n",
        "    x_out  = layers.Add()([x3_out, x2])\n",
        "    x_out  = layers.GlobalAveragePooling1D()(x_out)\n",
        "    outputs = layers.Dense(NUM_CLASSES, activation=\"softmax\")(x_out)\n",
        "    return keras.Model(inputs, outputs)\n",
        "\n",
        "print(\"🔧 Building FP32 skeleton to load weights...\")\n",
        "fp32_model = build_fp32_skeleton()\n",
        "fp32_model.load_weights(FP32_H5_PATH)\n",
        "print(\"✅ FP32 weights loaded successfully.\")\n",
        "\n",
        "# Quick sanity check — list layers with weight counts\n",
        "print(\"\\nFP32 weighted layers:\")\n",
        "fp32_weighted = [l for l in fp32_model.layers if len(l.get_weights()) > 0]\n",
        "for i, l in enumerate(fp32_weighted):\n",
        "    shapes = [w.shape for w in l.get_weights()]\n",
        "    print(f\"  [{i}] {l.name:35s}  weights: {shapes}\")"
